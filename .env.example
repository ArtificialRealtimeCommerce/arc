# Arc mainnet. Chain ID 5042 (testnet is 5042002 — do not mix them up).
ARC_CHAIN_ID=5042
# No official public RPC confirmed at launch. Use your own provider (Chainstack, GetBlock, Alchemy)
# or a third-party endpoint you trust. Never point this at testnet by accident.
ARC_RPC_URL=

# Postgres (Railway public proxy URL works)
DATABASE_URL=postgres://user:pass@host:5432/arc

# Contract addresses on Arc mainnet — fill from official Arc / ERC-8004 / ERC-8183 deployments.
# Leave blank to skip that indexer module.
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=
ERC8183_JOB_REGISTRY=
# USDC is native gas on Arc; ERC-20 style transfer events (used by x402 settlement) are
# emitted by the USDC token contract / precompile. Fill with the canonical address.
USDC_ADDRESS=

# Indexer tuning
START_BLOCK=latest        # "latest" = start from head (no backfill), or a block number
BLOCK_BATCH=50            # getLogs range per request; lower if provider caps it
POLL_INTERVAL_MS=800      # Arc finality is sub-second; 800ms is a sane default

# API
PORT=3000
